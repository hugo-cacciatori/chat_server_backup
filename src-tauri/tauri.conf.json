{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatServerBackup",
  "version": "0.2.0",
  "identifier": "com.hugocacciatori.chatserverbackup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "ChatServerBackup",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
